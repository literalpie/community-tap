# Convex
CONVEX_DEPLOYMENT=your-deployment-name
VITE_CONVEX_URL=https://your-convex-url.convex.cloud
COMMUNITY_TAP_SERVICE_ID=example.community-tap

# App URL (for production)
VITE_PUBLIC_URL=https://your-app-url.com

# AT-Proto OAuth (for production - generate with scripts/gen-key.ts)
# PRIVATE_KEY={"kty":"EC","crv":"P-256","alg":"ES256","x":"...","y":"...","d":"..."}

# Tap configuration (VITE_ prefix required for import.meta.env)
VITE_TAP_BASE_URL=https://your-tap-instance.up.railway.app
TAP_ADMIN_PASSWORD=admin-password-matching-tap-instance

# Machine-to-machine auth for /hooks/addRepo
ADD_REPO_SECRET=another-random-secret
