{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "browser": true
  },
  "ignorePatterns": ["src/routeTree.gen.ts", "dist/", ".output/"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "pedantic": "off",
    "nursery": "off"
  },
  "rules": {
    "import/no-cycle": "off",
    "import/default": "off",
    "import/named": "off",
    "import/namespace": "off",
    "unicorn/filename-case": "off",
    "no-underscore-dangle": [
      "error",
      { "allow": ["_id", "_client", "_convexClient"] }
    ],
    "no-new": "warn",
    "preserve-caught-error": "off",
    "consistent-function-scoping": "off"
  }
}
